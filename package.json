{
    "name": "succinctcoin",
    "version": "0.0.1",
    "description": "minimalistic crypto-currency",
    "productName": "succinctcoin",
    "main": "./.webpack/main",
    "keywords": [
        "echowaves",
        "succinct coin",
        "SuccinctCoin",
        "electron",
        "react"
    ],
    "author": "Echowaves <dmitry@echowaves.com>",
    "license": "MIT",
    "scripts": {
        "test": "jest --ci --coverage --reporters=default ",
        "test:ci": "jest --watch",
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "lint": "eslint . --ext .js,.ts"
    },
    "config": {
        "forge": {
            "packagerConfig": {},
            "makers": [
                {
                    "name": "@electron-forge/maker-squirrel",
                    "config": {
                        "name": "succinctCoin"
                    }
                },
                {
                    "name": "@electron-forge/maker-zip",
                    "platforms": [
                        "darwin"
                    ]
                },
                {
                    "name": "@electron-forge/maker-deb",
                    "config": {
                        "name": "succinctCoin"
                    }
                },
                {
                    "name": "@electron-forge/maker-rpm",
                    "config": {
                        "name": "succinctCoin"
                    }
                }
            ],
            "plugins": [
                {
                    "name": "@electron-forge/plugin-webpack",
                    "config": {
                        "mainConfig": "./webpack.main.config.js",
                        "renderer": {
                            "config": "./webpack.renderer.config.js",
                            "entryPoints": [
                                {
                                    "html": "./src/renderer/index.html",
                                    "js": "./src/renderer/index.js",
                                    "name": "main_window",
                                    "preload": {
                                        "js": "./src/renderer/preload.js"
                                    }
                                }
                            ]
                        }
                    }
                }
            ]
        }
    },
    "jest": {
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.js"
        ]
    },
    "build": {
        "appId": "com.echowaves.SuccinctCoin",
        "files": [],
        "mac": {
            "target": "dmg",
            "icon": "src/static/assets/logo.png"
        },
        "win": {
            "target": "nsis",
            "icon": "src/static/assets/logo.png"
        },
        "linux": {
            "target": "deb",
            "icon": "src/static/assets/logo.png",
            "category": "Development"
        }
    },
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/eslint-parser": "^7.25.9",
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@babel/preset-env": "^7.26.0",
        "@babel/preset-react": "^7.26.3",
        "@electron-forge/cli": "^7.4.0",
        "@electron-forge/maker-deb": "^7.4.0",
        "@electron-forge/maker-rpm": "^7.4.0",
        "@electron-forge/maker-squirrel": "^7.4.0",
        "@electron-forge/maker-zip": "^7.4.0",
        "@electron-forge/plugin-webpack": "^7.4.0",
        "@testing-library/react": "^16.1.0",
          "babel-loader": "10.1.1",
        "concurrently": "10.0.0",
            "copy-webpack-plugin": "14.0.0",
        "cross-env": "10.1.0",
        "css-loader": "^7.1.2",
         "electron": "42.3.0",
          "eslint": "9.39.4",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-import": "^2.31.0",
          "eslint-plugin-jest": "29.15.2",
        "eslint-plugin-jsx-a11y": "^6.10.0",
        "eslint-plugin-react": "^7.37.0",
          "eslint-plugin-react-hooks": "7.1.1",
          "jest": "30.4.2",
        "node-loader": "^2.1.0",
        "style-loader": "^4.0.0"
    },
    "dependencies": {
        "@chainsafe/discv5": "^2.0.0",
        "@chainsafe/libp2p-noise": "^17.0.0",
        "@libp2p/floodsub": "^11.0.22",
        "@libp2p/mdns": "^12.0.23",
        "@libp2p/mplex": "^12.0.23",
        "@libp2p/tcp": "^11.0.20",
        "big.js": "6.2.1",
        "bootstrap": "^5.3.3",
         "cors": "2.8.6",
        "dayjs": "^1.11.13",
        "electron-is-dev": "3.0.1",
          "electron-squirrel-startup": "1.0.1",
        "express": "5.2.1",
        "flash-store": "1.0.6",
        "ipfs-pubsub-room": "^3.0.0",
        "libp2p": "^3.3.2",
        "obj2fs-hoc": "1.3.2",
        "react": "^19.0.0",
        "react-bootstrap": "^2.10.9",
        "react-dom": "^19.0.0",
        "react-router-bootstrap": "^0.26.3",
         "react-router-dom": "^7.16.0",
        "uuid": "8.3.2"
    }
}
