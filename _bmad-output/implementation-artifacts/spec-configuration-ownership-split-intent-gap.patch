diff --git a/src/renderer/preload.test.js b/src/renderer/preload.test.js
new file mode 100644
index 0000000..dba6f9e
--- /dev/null
+++ b/src/renderer/preload.test.js
@@ -0,0 +1,103 @@
+// AD-8 bridge rows (spec-launch-readiness, story 8): the port crosses the
+// renderer boundary via a synchronous IPC pull, never via a config import.
+//
+// The electron mock mirrors the isolated-world preload surface:
+// contextBridge + ipcRenderer only — no `app`. A real sandboxed preload's
+// require('electron') exposes no `app`, so if the preload (or anything it
+// loads, e.g. src/config.js via electron-is-dev) ever depended on
+// `electron.app`, it would fail here instead of in the packaged app.
+
+let mockIsDev = false
+
+jest.mock('electron', () => ({
+  contextBridge: { exposeInMainWorld: jest.fn() },
+  ipcRenderer: {
+    send: jest.fn(),
+    sendSync: jest.fn(),
+    on: jest.fn(),
+  },
+}))
+
+jest.mock('electron-is-dev', () => mockIsDev)
+
+// Loads a fresh module registry under the given dev flag. The mocked
+// ipcRenderer.sendSync answers 'api-port' with the real app-config
+// DEFAULT_PORT evaluated under that flag — the value the main process sends
+// (src/main/api.js '/api/port' handler).
+function loadBridge(isDev) {
+  mockIsDev = isDev
+  jest.resetModules()
+
+  const electron = require('electron')
+  const { DEFAULT_PORT } = require('../config').default
+  electron.ipcRenderer.sendSync.mockImplementation(
+    channel => (channel === 'api-port' ? DEFAULT_PORT : undefined),
+  )
+
+  require('./preload')
+
+  const [, api] = electron.contextBridge.exposeInMainWorld.mock.calls[0]
+  return { api, electron, DEFAULT_PORT }
+}
+
+describe('preload bridge (AD-8 synchronous port pull)', () => {
+  it('BRIDGE_PROD_PORT: getApiPort synchronously returns the prod DEFAULT_PORT', () => {
+    const { api, electron, DEFAULT_PORT } = loadBridge(false)
+
+    expect(DEFAULT_PORT).toBe(3333)
+    expect(electron.contextBridge.exposeInMainWorld)
+      .toHaveBeenCalledWith('electronAPI', expect.anything())
+    expect(typeof api.getApiPort).toBe('function')
+
+    const port = api.getApiPort()
+
+    expect(typeof port).toBe('number')
+    expect(port).toBe(3333)
+    expect(electron.ipcRenderer.sendSync).toHaveBeenCalledWith('api-port')
+  })
+
+  it('BRIDGE_DEV_PORT: getApiPort synchronously returns the dev DEFAULT_PORT', () => {
+    const { api, electron, DEFAULT_PORT } = loadBridge(true)
+
+    expect(DEFAULT_PORT).toBe(3001)
+    expect(typeof api.getApiPort).toBe('function')
+
+    const port = api.getApiPort()
+
+    expect(typeof port).toBe('number')
+    expect(port).toBe(3001)
+    expect(electron.ipcRenderer.sendSync).toHaveBeenCalledWith('api-port')
+  })
+
+  describe('pre-existing methods still route their whitelisted channels', () => {
+    let api
+    let electron
+
+    beforeEach(() => {
+      ({ api, electron } = loadBridge(false))
+    })
+
+    it('send(api/blocks) routes to ipcRenderer.send', () => {
+      const payload = { id: 1 }
+
+      api.send('api/blocks', payload)
+
+      expect(electron.ipcRenderer.send).toHaveBeenCalledWith('api/blocks', payload)
+    })
+
+    it('sendSync(api/wallet-info) routes to ipcRenderer.sendSync', () => {
+      api.sendSync('api/wallet-info')
+
+      expect(electron.ipcRenderer.sendSync)
+        .toHaveBeenCalledWith('api/wallet-info', undefined)
+    })
+
+    it('channels outside the whitelist are not routed', () => {
+      api.send('not-whitelisted')
+      api.sendSync('not-whitelisted')
+
+      expect(electron.ipcRenderer.send).not.toHaveBeenCalled()
+      expect(electron.ipcRenderer.sendSync).not.toHaveBeenCalled()
+    })
+  })
+})
