diff --git a/src/renderer/config-boundary.test.js b/src/renderer/config-boundary.test.js
new file mode 100644
index 0000000..b23dd97
--- /dev/null
+++ b/src/renderer/config-boundary.test.js
@@ -0,0 +1,76 @@
+// Story 8 (configuration-ownership-split): the renderer→app config boundary.
+//
+// src/config.js reads electron-is-dev at module scope; the real package is
+// untransformed ESM under the CJS transform, so it is mocked before any
+// config import below (same pattern as the main-process tests).
+jest.mock('electron-is-dev', () => false)
+
+import globalConfig from '../config'
+import coreConfig from '../main/config'
+
+const fs = require('fs')
+const path = require('path')
+
+const RENDERER_DIR = __dirname
+const CONFIG_MODULE_PATH = path.resolve(RENDERER_DIR, '../config.js')
+
+// The three import-specifier forms the boundary must close: static
+// `from '…'`, CJS `require('…')`, and dynamic `import('…')`.
+const SPECIFIER_PATTERNS = [
+  /\bfrom\s+['"]([^'"]+)['"]/g,
+  /\brequire\s*\(\s*['"]([^'"]+)['"]\s*\)/g,
+  /\bimport\s*\(\s*['"]([^'"]+)['"]\s*\)/g,
+]
+
+function collectRendererJsFiles(dir) {
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(entry => {
+    const fullPath = path.join(dir, entry.name)
+    if (entry.isDirectory()) return collectRendererJsFiles(fullPath)
+    if (entry.name.endsWith('.js') && !entry.name.endsWith('.test.js')) return [fullPath]
+    return []
+  })
+}
+
+function specifiersIn(source) {
+  return SPECIFIER_PATTERNS.flatMap(pattern => {
+    const specifiers = []
+    let match
+    while ((match = pattern.exec(source)) !== null) {
+      specifiers.push(match[1])
+    }
+    return specifiers
+  })
+}
+
+function resolvesToAppConfig(specifier, file) {
+  const resolved = path.resolve(path.dirname(file), specifier)
+  return resolved === CONFIG_MODULE_PATH || `${resolved}.js` === CONFIG_MODULE_PATH
+}
+
+describe('RENDERER_NO_CONFIG_IMPORT', () => {
+  it('no renderer file (except tests) imports the app config module', () => {
+    const offenders = []
+    for (const file of collectRendererJsFiles(RENDERER_DIR)) {
+      const source = fs.readFileSync(file, 'utf8')
+      for (const specifier of specifiersIn(source)) {
+        if (resolvesToAppConfig(specifier, file)) {
+          offenders.push(`${path.relative(RENDERER_DIR, file)} -> ${specifier}`)
+        }
+      }
+    }
+
+    expect(offenders).toEqual([])
+  })
+})
+
+describe('INTERVAL_OWNERSHIP', () => {
+  it('MINING_RECHECK_INTERVAL and VALIDATION_RATE are single-owned numbers', () => {
+    expect(typeof globalConfig.MINING_RECHECK_INTERVAL).toBe('number')
+    expect(typeof coreConfig.VALIDATION_RATE).toBe('number')
+
+    // Neither module exports the other's key: the shared default number is a
+    // coincidence, not an alias (AD-8: one owner per value).
+    expect(globalConfig.VALIDATION_RATE).toBeUndefined()
+    expect(coreConfig.MINING_RECHECK_INTERVAL).toBeUndefined()
+  })
+})
diff --git a/src/renderer/lib/api-base.js b/src/renderer/lib/api-base.js
new file mode 100644
index 0000000..95866b2
--- /dev/null
+++ b/src/renderer/lib/api-base.js
@@ -0,0 +1,8 @@
+// AD-8: the renderer reads no config file directly. The API port comes from
+// the preload bridge (window.electronAPI.getApiPort), which the main process
+// answers from the app config (src/config.js DEFAULT_PORT). The bridge is
+// read at call time, never at module scope, so renderer modules stay
+// importable outside Electron (e.g. under jest).
+const getApiBase = () => `http://localhost:${window.electronAPI.getApiPort()}`
+
+export default getApiBase
